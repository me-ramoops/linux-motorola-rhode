From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fwlta <monkeyfwlta@protonmail.com>
Date: Tue, 16 Sep 2026 00:00:00 -0300
Subject: [PATCH] Input: goodix-berlin - add gt9916s match

Same protocol as gt9916, used in motorola rhode touchscreen.

Signed-off-by: fwlta <monkeyfwlta@protonmail.com>
---
 drivers/input/touchscreen/goodix_berlin_spi.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/input/touchscreen/goodix_berlin_spi.c b/drivers/input/touchscreen/goodix_berlin_spi.c
--- a/drivers/input/touchscreen/goodix_berlin_spi.c
+++ b/drivers/input/touchscreen/goodix_berlin_spi.c
@@ -175,13 +175,15 @@
 static const struct spi_device_id goodix_berlin_spi_ids[] = {
 	{ .name = "gt9897", .driver_data = (long)&gt9897_data },
 	{ .name = "gt9916", .driver_data = (long)&gt9916_data },
+	{ .name = "gt9916s", .driver_data = (long)&gt9916_data },
 	{ },
 };
 MODULE_DEVICE_TABLE(spi, goodix_berlin_spi_ids);

 static const struct of_device_id goodix_berlin_spi_of_match[] = {
 	{ .compatible = "goodix,gt9897", .data = &gt9897_data },
 	{ .compatible = "goodix,gt9916", .data = &gt9916_data },
+	{ .compatible = "goodix,gt9916s", .data = &gt9916_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, goodix_berlin_spi_of_match);
 MODULE_DEVICE_TABLE(of, goodix_berlin_spi_of_match);
--
2.55.0
