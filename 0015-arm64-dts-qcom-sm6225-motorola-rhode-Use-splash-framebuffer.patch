From b9dedbd1800df32812ebd3b4c5396399b6df8204 Mon Sep 17 00:00:00 2001
From: fwlta <monkeyfwlta@protonmail.com>
Date: Wed, 16 Sep 2026 14:10:45 -0300
Subject: [PATCH 15/15] arm64: dts: qcom: sm6225-motorola-rhode: use splash
 framebuffer, drop uart

---
 .../boot/dts/qcom/sm6225-motorola-rhode.dts   | 30 ++++++++++++-------
 1 file changed, 20 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6225-motorola-rhode.dts b/arch/arm64/boot/dts/qcom/sm6225-motorola-rhode.dts
index 58cb5bfbd..17ae67583 100644
--- a/arch/arm64/boot/dts/qcom/sm6225-motorola-rhode.dts
+++ b/arch/arm64/boot/dts/qcom/sm6225-motorola-rhode.dts
@@ -12,13 +12,22 @@ / {
 	qcom,msm-id = <518 0x10000>;
 	qcom,board-id = <0x0 0xb000>;
 
-	aliases {
-		serial0 = &uart4;
-	};
-
 	chosen {
-		stdout-path = "serial0:115200n8";
-		bootargs = "pmos.nosplash clk_ignore_unused pd_ignore_unused";
+		bootargs = "console=tty0 pmos.nosplash clk_ignore_unused pd_ignore_unused";
+
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer0: framebuffer@5c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x00 0x5c000000 0x00 0xf00000>;
+			width = <0x438>;
+			height = <0x960>;
+			stride = <0x10e0>;
+			format = "a8b8g8r8";
+			memory-region = <&cont_splash_region>;
+		};
 	};
 
 	vph_pwr: regulator-vph-pwr {
@@ -35,6 +44,11 @@ reserved-memory {
 		#size-cells = <2>;
 		ranges;
 
+		cont_splash_region: cont_splash_region@5c000000 {
+			reg = <0x00 0x5c000000 0x00 0xf00000>;
+			no-map;
+		};
+
 		ramoops@5d000000 {
 			compatible = "ramoops";
 			reg = <0x00 0x5d000000 0x00 0x400000>;
@@ -237,10 +251,6 @@ &sleep_clk {
 	clock-frequency = <32764>;
 };
 
-&uart4 {
-	status = "okay";
-};
-
 &ufs_mem_hc {
 	vcc-supply = <&pm6125_l24>;
 	vcc-max-microamp = <800000>;
