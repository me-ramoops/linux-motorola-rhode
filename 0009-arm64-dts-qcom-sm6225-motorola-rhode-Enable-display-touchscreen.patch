From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fwlta <monkeyfwlta@protonmail.com>
Date: Tue, 16 Sep 2026 00:00:00 -0300
Subject: [PATCH] arm64: dts: qcom: sm6225-motorola-rhode: enable display and touchscreen

Visionox rm692e5 panel on mdss dsi0 and goodix gt9916s touch on
qupv3 spi2, values from stock rhode dtbo.

Signed-off-by: fwlta <monkeyfwlta@protonmail.com>
---
 .../boot/dts/qcom/sm6225-motorola-rhode.dts   | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225-motorola-rhode.dts b/arch/arm64/boot/dts/qcom/sm6225-motorola-rhode.dts
@@ -286,3 +286,68 @@
 &xo_board {
 	clock-frequency = <19200000>;
 };
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+
+	panel@0 {
+		compatible = "motorola,rhode-rm692e5";
+		reg = <0>;
+
+		reset-gpios = <&tlmm 82 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&pm6125_l14>;
+		dvdd-supply = <&pm6125_l7>;
+		vci-supply = <&pm6125_l15>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+};
+
+&spi2 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "goodix,gt9916s";
+		reg = <0>;
+		spi-max-frequency = <9600000>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <97 IRQ_TYPE_LEVEL_LOW>;
+
+		reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&ts_avdd>;
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <2400>;
+	};
+};
+
+/ {
+	ts_avdd: regulator-ts-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "ts_avdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 2 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
--
2.55.0
