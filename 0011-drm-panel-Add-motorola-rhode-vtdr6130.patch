From 75f139b06b1182504cf0aeedb6fba73b8beac7af Mon Sep 17 00:00:00 2001
From: fwlta <monkeyfwlta@protonmail.com>
Date: Wed, 16 Sep 2026 11:24:20 -0300
Subject: [PATCH 11/14] drm: panel: Add motorola rhode vtdr6130 panel driver

Signed-off-by: fwlta <monkeyfwlta@protonmail.com>
---
 .../panel/motorola,rhode-vtdr6130.yaml        |  40 +++
 drivers/gpu/drm/panel/Kconfig                 |  10 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../gpu/drm/panel/panel-motorola-vtdr6130.c   | 329 ++++++++++++++++++
 4 files changed, 380 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/panel/motorola,rhode-vtdr6130.yaml b/Documentation/devicetree/bindings/display/panel/motorola,rhode-vtdr6130.yaml
index 8fce03f3e..1fe916609 100644
--- a/Documentation/devicetree/bindings/display/panel/motorola,rhode-vtdr6130.yaml
+++ b/Documentation/devicetree/bindings/display/panel/motorola,rhode-vtdr6130.yaml
@@ -38,3 +38,43 @@ required:
   - port
 
 unevaluatedProperties: false
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/motorola,rhode-vtdr6130.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Motorola Moto G52 CSOT vtdr6130 DSI panel
+
+maintainers:
+  - fwlta <monkeyfwlta@protonmail.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: motorola,rhode-vtdr6130
+
+  reg:
+    maxItems: 1
+
+  dvdd-supply:
+    description: Digital voltage rail
+
+  vci-supply:
+    description: Analog voltage rail
+
+  vddio-supply:
+    description: I/O voltage rail
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - dvdd-supply
+  - vci-supply
+  - vddio-supply
+  - port
+
+unevaluatedProperties: false
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 857740162..e49b379db 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -563,6 +563,16 @@ config DRM_PANEL_MOTOROLA_RHODE_RM692E5
 	  1080x2400 DSC command mode AMOLED panel found in the Motorola
 	  Moto G52 (rhode).
 
+config DRM_PANEL_MOTOROLA_RHODE_VTDR6130
+	tristate "Motorola Moto G52 CSOT vtdr6130 1080x2400 DSI cmd mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the CSOT vtdr6130
+	  1080x2400 DSC command mode AMOLED panel found in the Motorola
+	  Moto G52 (rhode).
+
 config DRM_PANEL_NEC_NL8048HL11
 	tristate "NEC NL8048HL11 RGB panel"
 	depends on GPIOLIB && OF && SPI
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 0d6f68d98..ad073cd7e 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -54,6 +54,7 @@ obj-$(CONFIG_DRM_PANEL_MAGNACHIP_D53E6EA8966) += panel-magnachip-d53e6ea8966.o
 obj-$(CONFIG_DRM_PANEL_MOTOROLA_MOT) += panel-motorola-mot.o
 obj-$(CONFIG_DRM_PANEL_MOTOROLA_RHODE_NT37701) += panel-motorola-nt37701.o
 obj-$(CONFIG_DRM_PANEL_MOTOROLA_RHODE_RM692E5) += panel-motorola-rm692e5.o
+obj-$(CONFIG_DRM_PANEL_MOTOROLA_RHODE_VTDR6130) += panel-motorola-vtdr6130.o
 obj-$(CONFIG_DRM_PANEL_NEC_NL8048HL11) += panel-nec-nl8048hl11.o
 obj-$(CONFIG_DRM_PANEL_NEWVISION_NV3051D) += panel-newvision-nv3051d.o
 obj-$(CONFIG_DRM_PANEL_NEWVISION_NV3052C) += panel-newvision-nv3052c.o
diff --git a/drivers/gpu/drm/panel/panel-motorola-vtdr6130.c b/drivers/gpu/drm/panel/panel-motorola-vtdr6130.c
index 610aeae4e..a209ae77b 100644
--- a/drivers/gpu/drm/panel/panel-motorola-vtdr6130.c
+++ b/drivers/gpu/drm/panel/panel-motorola-vtdr6130.c
@@ -327,3 +327,332 @@ module_mipi_dsi_driver(rhode_vtdr6130_driver);
 
 MODULE_DESCRIPTION("DRM driver for motorola rhode vtdr6130 DSI panel");
 MODULE_LICENSE("GPL");
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct rhode_vtdr6130_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data supplies[3];
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct rhode_vtdr6130_panel *to_rhode_vtdr6130_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct rhode_vtdr6130_panel, panel);
+}
+
+static void rhode_vtdr6130_reset(struct rhode_vtdr6130_panel *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(20000, 21000);
+}
+
+static void rhode_vtdr6130_on(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	dsi_ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x03, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x35, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x53, 0x20);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x51, 0x00, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x59, 0x09);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x62, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x6c, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x6f, 0x02);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x70, 0x11, 0x00, 0x00, 0xab, 0x30, 0x80, 0x09, 0x60, 0x04, 0x38, 0x00, 0x0c, 0x04, 0x38, 0x04, 0x38, 0x02, 0x00, 0x03, 0x1c, 0x00, 0x20, 0x01, 0x7e, 0x00, 0x0f, 0x00, 0x0c, 0x08, 0xbb, 0x04, 0x3d, 0x18, 0x00, 0x10, 0xf0, 0x07, 0x10, 0x20, 0x00, 0x06, 0x0f, 0x0f, 0x33, 0x0e, 0x1c, 0x2a, 0x38, 0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b, 0x7d, 0x7e, 0x02, 0x02, 0x22, 0x00, 0x2a, 0x40, 0x2a, 0xbe, 0x3a, 0xfc, 0x3a, 0xfa, 0x3a, 0xf8, 0x3b, 0x38, 0x3b, 0x78, 0x3b, 0xb6, 0x4b, 0xb6, 0x4b, 0xf4, 0x4b, 0xf4, 0x6c, 0x34, 0x84, 0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xaa, 0x10);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb3, 0xc6);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xaa, 0x14);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb2, 0x03, 0x33);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb4, 0x00, 0x6c, 0x00, 0x00, 0x00, 0x6c, 0x00, 0x00, 0x00, 0x6c, 0x00, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb5, 0x00, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x06, 0x01);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb9, 0x00, 0x00, 0x0a, 0x18, 0x18, 0x18);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xbc, 0x10, 0x00, 0x00, 0x0a, 0x11, 0x18, 0x78, 0x18, 0x78, 0x18, 0x78);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xbe, 0x10, 0x10, 0x00, 0x0a, 0x22, 0x18, 0x48, 0x18, 0x48, 0x18, 0x48);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xff, 0x5a, 0x80);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x65, 0x13);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xfd, 0x01);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xff, 0x5a, 0x81);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x65, 0x05);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf3, 0x0f);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xff, 0x5a, 0x82);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf9, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xff, 0x5a, 0x83);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x65, 0x04);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf8, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x39);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x11);
+	mipi_dsi_msleep(dsi_ctx, 130);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x29);
+	mipi_dsi_msleep(dsi_ctx, 20);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xaa, 0x10);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x65, 0x03);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xeb, 0x18);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0xaa, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xff, 0x5a, 0x00);
+}
+
+static int rhode_vtdr6130_disable(struct drm_panel *panel)
+{
+	struct rhode_vtdr6130_panel *ctx = to_rhode_vtdr6130_panel(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfe, 0x00);
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+
+	mipi_dsi_msleep(&dsi_ctx, 100);
+
+	return dsi_ctx.accum_err;
+}
+
+static int rhode_vtdr6130_prepare(struct drm_panel *panel)
+{
+	struct rhode_vtdr6130_panel *ctx = to_rhode_vtdr6130_panel(panel);
+	struct drm_dsc_picture_parameter_set pps;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	dsi_ctx.accum_err = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	rhode_vtdr6130_reset(ctx);
+
+	rhode_vtdr6130_on(&dsi_ctx);
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	mipi_dsi_compression_mode_ext_multi(&dsi_ctx, true, MIPI_DSI_COMPRESSION_DSC, 0);
+	mipi_dsi_msleep(&dsi_ctx, 28);
+
+	if (dsi_ctx.accum_err) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	}
+
+	return dsi_ctx.accum_err;
+}
+
+static int rhode_vtdr6130_unprepare(struct drm_panel *panel)
+{
+	struct rhode_vtdr6130_panel *ctx = to_rhode_vtdr6130_panel(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode rhode_vtdr6130_mode = {
+	.clock = (1080 + 32 + 32 + 32) * (2400 + 1248 + 4 + 20) * 90 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 32,
+	.hsync_end = 1080 + 32 + 32,
+	.htotal = 1080 + 32 + 32 + 32,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 1248,
+	.vsync_end = 2400 + 1248 + 4,
+	.vtotal = 2400 + 1248 + 4 + 20,
+	.width_mm = 68,
+	.height_mm = 152,
+};
+
+static int rhode_vtdr6130_get_modes(struct drm_panel *panel,
+					struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &rhode_vtdr6130_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs rhode_vtdr6130_panel_funcs = {
+	.prepare = rhode_vtdr6130_prepare,
+	.unprepare = rhode_vtdr6130_unprepare,
+	.disable = rhode_vtdr6130_disable,
+	.get_modes = rhode_vtdr6130_get_modes,
+};
+
+static int rhode_vtdr6130_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static int rhode_vtdr6130_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops rhode_vtdr6130_bl_ops = {
+	.update_status = rhode_vtdr6130_bl_update_status,
+	.get_brightness = rhode_vtdr6130_bl_get_brightness,
+};
+
+static struct backlight_device *
+rhode_vtdr6130_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 3514,
+		.max_brightness = 3514,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &rhode_vtdr6130_bl_ops, &props);
+}
+
+static int rhode_vtdr6130_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct rhode_vtdr6130_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct rhode_vtdr6130_panel, panel,
+				   &rhode_vtdr6130_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supplies[0].supply = "vddio";
+	ctx->supplies[1].supply = "dvdd";
+	ctx->supplies[2].supply = "vci";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = rhode_vtdr6130_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	dsi->dsc = &ctx->dsc;
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 12;
+	ctx->dsc.slice_width = 1080;
+
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void rhode_vtdr6130_remove(struct mipi_dsi_device *dsi)
+{
+	struct rhode_vtdr6130_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id rhode_vtdr6130_of_match[] = {
+	{ .compatible = "motorola,rhode-vtdr6130" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rhode_vtdr6130_of_match);
+
+static struct mipi_dsi_driver rhode_vtdr6130_driver = {
+	.probe = rhode_vtdr6130_probe,
+	.remove = rhode_vtdr6130_remove,
+	.driver = {
+		.name = "panel-motorola-rhode-vtdr6130",
+		.of_match_table = rhode_vtdr6130_of_match,
+	},
+};
+module_mipi_dsi_driver(rhode_vtdr6130_driver);
+
+MODULE_DESCRIPTION("DRM driver for motorola rhode vtdr6130 DSI panel");
+MODULE_LICENSE("GPL");
