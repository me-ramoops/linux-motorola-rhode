From 5f4d4deecda1b428f3fcdc5950402b888f14eb56 Mon Sep 17 00:00:00 2001
From: fwlta <monkeyfwlta@protonmail.com>
Date: Wed, 16 Sep 2026 11:24:19 -0300
Subject: [PATCH 10/15] drm: panel: Add motorola rhode nt37701 panel driver

Signed-off-by: fwlta <monkeyfwlta@protonmail.com>
---
 .../display/panel/motorola,rhode-nt37701.yaml | 40 +++++++++++++++++++
 drivers/gpu/drm/panel/Kconfig                 | 10 +++++
 drivers/gpu/drm/panel/Makefile                |  1 +
 3 files changed, 51 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/panel/motorola,rhode-nt37701.yaml b/Documentation/devicetree/bindings/display/panel/motorola,rhode-nt37701.yaml
index dac949731..89febe938 100644
--- a/Documentation/devicetree/bindings/display/panel/motorola,rhode-nt37701.yaml
+++ b/Documentation/devicetree/bindings/display/panel/motorola,rhode-nt37701.yaml
@@ -38,3 +38,43 @@ required:
   - port
 
 unevaluatedProperties: false
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/motorola,rhode-nt37701.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Motorola Moto G52 CSOT nt37701 DSI panel
+
+maintainers:
+  - fwlta <monkeyfwlta@protonmail.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: motorola,rhode-nt37701
+
+  reg:
+    maxItems: 1
+
+  dvdd-supply:
+    description: Digital voltage rail
+
+  vci-supply:
+    description: Analog voltage rail
+
+  vddio-supply:
+    description: I/O voltage rail
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - dvdd-supply
+  - vci-supply
+  - vddio-supply
+  - port
+
+unevaluatedProperties: false
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 1556785b8..857740162 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -543,6 +543,16 @@ config DRM_PANEL_MOTOROLA_MOT
 	  unknown. The panel has a 540x960 resolution and uses 24 bit RGB per
 	  pixel.
 
+config DRM_PANEL_MOTOROLA_RHODE_NT37701
+	tristate "Motorola Moto G52 CSOT nt37701 1080x2400 DSI cmd mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the CSOT nt37701
+	  1080x2400 DSC command mode AMOLED panel found in the Motorola
+	  Moto G52 (rhode).
+
 config DRM_PANEL_MOTOROLA_RHODE_RM692E5
 	tristate "Motorola Moto G52 Visionox rm692e5 1080x2400 DSI cmd mode panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index fad0873e5..0d6f68d98 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -52,6 +52,7 @@ obj-$(CONFIG_DRM_PANEL_LG_SW43408) += panel-lg-sw43408.o
 obj-$(CONFIG_DRM_PANEL_LXD_M9189A) += panel-lxd-m9189a.o
 obj-$(CONFIG_DRM_PANEL_MAGNACHIP_D53E6EA8966) += panel-magnachip-d53e6ea8966.o
 obj-$(CONFIG_DRM_PANEL_MOTOROLA_MOT) += panel-motorola-mot.o
+obj-$(CONFIG_DRM_PANEL_MOTOROLA_RHODE_NT37701) += panel-motorola-nt37701.o
 obj-$(CONFIG_DRM_PANEL_MOTOROLA_RHODE_RM692E5) += panel-motorola-rm692e5.o
 obj-$(CONFIG_DRM_PANEL_NEC_NL8048HL11) += panel-nec-nl8048hl11.o
 obj-$(CONFIG_DRM_PANEL_NEWVISION_NV3051D) += panel-newvision-nv3051d.o
